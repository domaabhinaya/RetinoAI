# ---- RetinoAI Express backend -------------------------------------------
# Port for the Express clinical backend.
PORT=5000

# ---- Verified Flask AI engine (single source of truth for inference) -----
# Express calls this engine for every retinal analysis. Express performs no
# model inference of its own and never fabricates a value.
# Start the engine first:  python -m ai.service.api_server
FLASK_AI_BASE_URL=http://127.0.0.1:5001
# Request timeout in milliseconds (default 120000).
FLASK_AI_TIMEOUT_MS=120000

# NOTE: BLACKBOX_API_KEY / BLACKBOX_API_URL are intentionally NOT used for
# retinal screening. The verified Flask engine replaced that path. Blackbox may
# still be configured for unrelated non-retinal features.
